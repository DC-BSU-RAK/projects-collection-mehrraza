<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Header icon -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎨"
            android:textSize="52sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to Use Colour Mixer"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Step 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① Pick Colour A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#5856D6"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drag the Red, Green, and Blue sliders in the Colour A card. The swatch updates live as you move each slider."
            android:textSize="14sp"
            android:textColor="#3C3C43"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp" />

        <!-- Step 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="② Pick Colour B"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#5856D6"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Do the same in the Colour B card. You now have two distinct colours ready to blend."
            android:textSize="14sp"
            android:textColor="#3C3C43"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp" />

        <!-- Step 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="③ Press MIX!"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#5856D6"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The app averages the R, G, and B channels of both colours to produce the mixed result. The result swatch and its HEX code are shown below."
            android:textSize="14sp"
            android:textColor="#3C3C43"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp" />

        <!-- Reset note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="④ Reset"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#5856D6"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Press RESET to return all sliders to zero and start fresh."
            android:textSize="14sp"
            android:textColor="#3C3C43"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="24dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E5EA"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About Colour Mixer"
            android:textSize="13sp"
            android:textColor="#8E8E93"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Version 1.0 · Created for Smartphone Apps Assessment"
            android:textSize="12sp"
            android:textColor="#C7C7CC"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
