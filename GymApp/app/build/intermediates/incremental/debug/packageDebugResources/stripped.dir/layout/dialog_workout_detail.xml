<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_workout_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Workout"
        android:textColor="@color/accent_orange"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <View
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:background="@color/accent_orange"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_workout_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="20dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_workout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close"
        app:backgroundTint="@color/surface_dark"
        android:textColor="@color/accent_orange"
        app:strokeColor="@color/accent_orange"
        app:strokeWidth="1dp"
        app:cornerRadius="10dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

</LinearLayout>
